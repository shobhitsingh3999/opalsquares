# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Mirrored files of the licensed OnePack WordPress theme (used only by /original;
# missing files are proxied from opalsquare.in). Kept out of the public repo.
/public/wp-content/
/public/wp-includes/

# reference material
/ref/

# Source data pack with unconfirmed figures (kept private; see README)
/content/source/
